# Copy to .env and customize. .env is gitignored.
# Sourced by triage.sh and setup.sh. For Claude Code interactive sessions
# (so .mcp.json ${VAR} expansion works), also export these in ~/.zshrc.

# ── Slack app (create your own — PKCE OAuth, no client secret) ─────────────
# YAAS talks to Slack via a user-token OAuth app in YOUR workspace. Create one
# at https://api.slack.com/apps with PKCE OAuth enabled, the scopes listed in
# yaas-triage/setup/yaas-app-config.json, and redirect URL
# http://localhost:3118/callback. Then fill in the four values below and run
# setup.sh to authorize it under your own Slack identity.
#
# These are PUBLIC OAuth identifiers (no client secret — PKCE flow), but they
# are workspace-specific: use your own, don't commit real values back here.
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_WORKSPACE_NAME=
SLACK_WORKSPACE_DOMAIN=

# ── Jira (optional) — jira-call.sh + the dashboard's "open in Jira" links ──
# JIRA_BASE_URL is also what the dashboard uses to build issue/comment links.
# API token: https://id.atlassian.com/manage-profile/security/api-tokens, then
#   security add-generic-password -s jira-api-token -a yaas -w '<TOKEN>'
JIRA_EMAIL=
JIRA_BASE_URL=

# ── Coda MCP — only if you use Coda; leave blank to disable ────────────────
# Get a personal API token at https://coda.io/account → "Generate API token".
CODA_API_KEY=
CODA_MCP_PATH=${HOME}/.local/coda-mcp/dist/index.js

# ── Gmail reply identity — used by yaas-triage/skills/yaas-gmail-reply/ ────
# Format: "Display Name <email@example.com>"
YAAS_FROM_EMAIL=

# ── Triage knobs (optional; defaults shown) ────────────────────────────────
# claude --permission-mode when yaas-triage dispatches the worker (see `claude --help`).
# Choices include: default, acceptEdits, auto, bypassPermissions, dontAsk, plan.
YAAS_WORKER_PERMISSION_MODE=acceptEdits

# How long to keep per-dispatch worker logs (logs/worker-*.{log,ndjson}).
# 0 = never delete. Append-only triage.log/out/err are NOT touched.
YAAS_LOG_RETAIN_DAYS=14

# Default thread retirement age in days. Per-quest meta.json can override via
# "retire_slack_threads_after_days" (set to 0/false to disable per-quest).
YAAS_RETIRE_DEFAULT_DAYS=30
