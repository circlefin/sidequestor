# OS
.DS_Store

# Claude Code local config
.claude/
.claude.json

# Working documents
DRAFT-AGENT-DESIGN.md

# Keep directory structure
!state/quests/active/.gitkeep
!state/quests/completed/.gitkeep
!state/quests/archived/.gitkeep

# /skills/ at the repo root is a separate (personal) git repo —
# yaas-triage/skills/ holds the generic skills published with yaas-v2.
# Leading slash anchors this to the root so yaas-triage/skills/ is NOT matched.
/skills/

# Solution outputs
solution_sketches/
references/

# Logs
logs/
.notes/


# Local machine / tool config
.env
settings.json
.mcp.json
.vscode/
.local/

# Generated dependencies and caches
**/node_modules/
**/__pycache__/
*.py[cod]
.build/

# Local media / render output
videos/

# Local runtime state
state/*.json
state/*.ndjson
state/triage/*
!state/triage/.gitkeep
state/quests/active/*
!state/quests/active/.gitkeep
state/quests/completed/*
!state/quests/completed/.gitkeep
state/quests/archived/*
!state/quests/archived/.gitkeep
state/bin/
# gws export default output artifacts (do not commit)
download.txt
download.html

# partner-publish working cache (per-repo clones for 3-way merge)
solution-proposals/.partner-publish-cache/

# Editor / pre-edit backups (dashboard.html.bak, dashboard-server.py.bak, ...)
*.bak

# Stray runtime lag/state artifacts
*.lag
# ...except the per-checker watermark lag map, which is config, not an artifact.
# the orchestrator reads checkers/<type>.lag to hold a clean tick's watermark back by
# that many seconds. Without them a fresh clone gets zero lag on every checker.
!yaas-triage/checkers/*.lag

# The template-sync git-dir: a second GIT_DIR over this same worktree, used by
# yaas-triage/ops/sync-yaas-v2.sh to track the upstream Sidequestor template.
# It is a git repository, not project content. Without this line an existing
# repo's `git add -A` commits the whole object store into the host history.
.git-yaas-v2/
